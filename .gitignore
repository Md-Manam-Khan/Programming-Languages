.vscode/
.idea/
*.swp
*.swo
*.iml
.classpath
.project
.settings/

# C / C++ compiled output
*.o
*.obj
*.exe
*.out
a.out
*.gch
*.so
*.dll

# Assembly build artifacts
*.lst
*.map
*.bin

# Java compiled output
*.class
*.jar
target/
bin/
out/

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Node / JavaScript
node_modules/
