package-lock.json

# Dart
.dart_tool/
.packages
build/

# PHP
vendor/

# Logs & env
*.log
.env
.env.local

# ------------------------------------------------------------
# Force-track all source files.
# This repo exists to share code, so source files must never be
# excluded by a build-artifact rule above (or one added later).
# ------------------------------------------------------------
!*.c
!*.C
!*.h
!*.cpp
!*.asm
!*.java
!*.py
!*.js
!*.php
!*.dart
!*.md
!**/*.c
!**/*.C
!**/*.h
!**/*.cpp
!**/*.asm
!**/*.java
!**/*.py
!**/*.js
!**/*.php
!**/*.dart
!**/*.md
